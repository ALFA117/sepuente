# ── Stellar ──────────────────────────────────────────────
# Cuentas generadas por scripts/setup-testnet.ts
SIGNING_PUBLIC_KEY=G...
SIGNING_SECRET_KEY=S...
ISSUER_PUBLIC_KEY=G...
ISSUER_SECRET_KEY=S...
DISTRIBUTION_PUBLIC_KEY=G...
DISTRIBUTION_SECRET_KEY=S...

# TESTNET | PUBLIC
STELLAR_NETWORK=TESTNET
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org

# Activo de prueba (código de 4 letras max)
ASSET_CODE=TMXN
# Se completa con ISSUER_PUBLIC_KEY en tiempo de ejecución

# ── Auth ─────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_algo_largo_y_aleatorio
# Duración del JWT SEP-10 (segundos)
JWT_EXPIRY=86400

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Driver ───────────────────────────────────────────────
# mock | etherfuse
DRIVER=mock

# Etherfuse Sandbox
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://sandbox.etherfuse.com

# ── App ──────────────────────────────────────────────────
# Sin trailing slash, siempre HTTPS
NEXT_PUBLIC_APP_URL=https://sepuente.vercel.app

# Vars públicas usadas por el Demo (se completan con las claves de Stellar de arriba)
# NEXT_PUBLIC_ASSET_CODE debe coincidir con ASSET_CODE
NEXT_PUBLIC_ASSET_CODE=TMXN
# NEXT_PUBLIC_ISSUER_PUBLIC_KEY debe coincidir con ISSUER_PUBLIC_KEY
NEXT_PUBLIC_ISSUER_PUBLIC_KEY=G...
